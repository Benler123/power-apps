# Postgres connection string for the admin panel
DATABASE_URL=postgres://user:password@localhost:5432/feature_flags

# Connections are plaintext by default.
# Set to "require" only when connecting to a managed Postgres that enforces TLS.
PGSSLMODE=

# API server port (the Vite dev server proxies /api here)
PORT=3001

# Google sign-in (Firebase). Leave FIREBASE_PROJECT_ID unset to run the panel without auth.
# These VITE_* values are public client config, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
FIREBASE_PROJECT_ID=your-project

# Optional allow-list for who may sign in (defaults to any verified Google account)
ALLOWED_EMAIL_DOMAIN=
ALLOWED_EMAILS=
