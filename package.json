{
  "name": "feature-flag-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "migrate": "tsx src/server/migrate.ts",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.server.json && cp src/server/schema.sql dist/server/schema.sql",
    "build:web": "vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "pg": "8.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/express": "4.17.21",
    "@types/node": "20.17.10",
    "@types/pg": "8.11.10",
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "eslint": "9.17.0",
    "globals": "15.13.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.0",
    "vite": "6.0.3"
  }
}
